Bootstrap: docker
From: continuumio/miniconda3:latest

%files
    ca_rfd_clean.yml /ca_rfd_clean.yml

%post
    # 在构建时执行
    export CONDA_OVERRIDE_CUDA=12.1
    conda env create -f /ca_rfd_clean.yml
    conda clean -afy
    echo "source activate ca_rfd" >> ~/.bashrc

%environment
    # 容器启动时的环境变量
    export PATH=/opt/conda/envs/ca_rfd/bin:$PATH
    source /opt/conda/etc/profile.d/conda.sh
    conda activate ca_rfd
%runscript
    # 容器执行时默认运行的命令
    python --version
